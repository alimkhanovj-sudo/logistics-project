<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="LESSON.db" readonly="0" foreign_keys="0" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="931"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Shipments" custom_title="0" dock_id="1" table="4,9:mainShipments"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000012200ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">SELECT *
FROM Shipments
WHERE Delay &gt; 2;

SELECT Shipment, Customer
FROM Shipments
WHERE Customer = 'IKEA';

SELECT *
FROM Shipments
WHERE Delay &gt; 1
AND Pallets &gt; 15;

SELECT *
FROM Shipments
WHERE Customer = 'IKEA'
OR Customer = 'Amazon';

SELECT *
FROM Shipments
ORDER BY Delay DESC
LIMIT 2;

UPDATE Shipments
SET Delay = 7
WHERE Shipment = 'SH003';

DELETE FROM Shipments
WHERE shipment = 'SH005';

INSERT INTO Shipments
(Shipment, Customer, Delay, Pallets)
VALUES('SH006', 'Adidas', 3, 18);

SELECT Customer, COUNT(*)
FROM Shipments
GROUP BY Customer;

SELECT Customer, SUM(Pallets)
From Shipments;
GROUP BY Customer;

SELECT Customer, SUM(Delay)
From Shipments
GROUP BY Customer;

SELECT Customer, SUM(Pallets) AS Total_Pallets
FROM Shipments
GROUP BY Customer
ORDER BY Total_Pallets DESC
LIMIT 2;



</sql><current_tab id="0"/></tab_sql></sqlb_project>
