(
    CustomerID INTEGER PRIMARY KEY,
    CustomerName TEXT NOT NULL UNIQUE,
    Country TEXT NOT NULL,
    Manager TEXT
);</sql><sql name="SQL 3">CREATE TABLE Invoices
(
    InvoiceID INTEGER PRIMARY KEY,
    ShipmentID INTEGER NOT NULL,
    Amount REAL NOT NULL,
    Status TEXT NOT NULL,
    InvoiceDate TEXT NOT NULL,

    FOREIGN KEY (ShipmentID)
        REFERENCES Shipments(ShipmentID)
);</sql><sql name="Portfolio.sql" filename="C:/supply-chain-learning/Portfolio.sql">-- Reference to file &quot;C:/supply-chain-learning/Portfolio.sql&quot; (not supported by this version) --</sql><sql name="SQL 7">INSERT INTO Shipments
